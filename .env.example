# ── QuoteXtract — Docker environment variables ────────────────────────────────
# Copy this file to .env and fill in your values, then run:
#   docker compose up --build

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres

# ── Security ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ── Local AI model (Docker Model Runner) ──────────────────────────────────────
# Step 1 — start the local model (run this ONCE, before docker compose up):
#   docker model run hf.co/blazeofchi/pdf-ocr-rl-qwen3vl2b-sft-only
#
# The model runner exposes an OpenAI-compatible API on your host machine.
# Containers reach it via the host-gateway alias below (already wired in compose).
OPENAI_BASE_URL=http://model-runner.docker.internal/engines/llama.cpp/v1
OPENAI_API_KEY=local
OPENAI_MODEL=hf.co/blazeofchi/pdf-ocr-rl-qwen3vl2b-sft-only

# ── IMAP email polling (optional) ─────────────────────────────────────────────
# Leave IMAP_EMAIL blank to disable automatic email fetching.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_EMAIL=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL=60

# ── SMTP for sending emails (optional) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
